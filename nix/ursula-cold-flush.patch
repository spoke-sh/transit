+#[test]
+fn plan_next_cold_flush_batch_does_not_starve_a_large_second_stream() {
+    let mut machine = machine();
+    create_stream(&mut machine, "a-journal");
+    create_stream(&mut machine, "z-pages");
+    assert!(matches!(
+        machine.apply(append_cmd(stream("z-pages"), b"abcdefghijkl", Append::default())),
+        StreamResponse::Appended { .. }
+    ));
+    for pass in 0..4 {
+        assert!(matches!(
+            machine.apply(append_cmd(stream("a-journal"), b"x", Append::default())),
+            StreamResponse::Appended { .. }
+        ));
+        let candidates = machine.plan_next_cold_flush_batch(4, 4, 4, 4)
+            .expect("plan bounded mixed-stream batch");
+        assert_eq!(candidates.len(), 2);
+        assert_eq!(candidates[0].stream_id, stream("a-journal"));
+        assert_eq!(candidates[0].payload, b"x");
+        assert_eq!(candidates[1].stream_id, stream("z-pages"));
+        assert_eq!((candidates[1].start_offset, candidates[1].end_offset), (pass * 3, (pass + 1) * 3));
+        assert_eq!(candidates.iter().map(|candidate| candidate.payload.len()).sum::<usize>(), 4);
+        // Planning alone does not advance durable cold coverage.
+        assert_eq!(machine.hot_start_offset(&stream("z-pages")), pass * 3);
+        for (index, candidate) in candidates.iter().enumerate() {
+            let response = machine.apply(flush_candidate_cmd(
+                candidate.stream_id.clone(), candidate,
+                &format!("s3://bucket/fair-flush/{pass}/{index}"),
+            ));
+            assert!(!matches!(response, StreamResponse::Error { .. }), "{response:?}");
+        }
+    }
+    assert_eq!(machine.hot_payload_len(&stream("z-pages")), Ok(0));
+    assert_eq!(machine.hot_payload_len(&stream("a-journal")), Ok(0));
