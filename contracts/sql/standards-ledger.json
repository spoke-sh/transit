  "features": [
    {
      "id": "E021-E051",
      "standard": "iso_sql_2023_foundation",
      "edition_clause": "ISO/IEC 9075-2:2023 §4.2-4.6",
      "title": "Core scalar types, exact numeric DECIMAL, and character collations",
      "owner": "packages/zig/transit-fuze/src/Types.zig",
      "dependencies": [
        "UCS_BASIC"
      ],
      "deviations": "Selected scalar types and collations. DECIMAL arithmetic uses bounded explicit DECIMAL_* functions with declared result precision, scale and rounding; ordered SUM widens to DECIMAL(38,s). Frozen column semantics carry exact TZif artifacts for AT TIME ZONE, TIME_BUCKET and LOCAL_TO_UTC. General infix arithmetic and host timezone lookup are not admitted. Scalar execution and saved-plan checks have component evidence; installed scalar transport/recovery qualification remains pending.",
      "corpus_sources": [
        "contracts/sql/corpus/statements.json",
        "contracts/sql/corpus/parameters.json"
      ],
      "states": {
        "parse": "implemented",
