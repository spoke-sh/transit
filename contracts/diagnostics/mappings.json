{
  "version": 1,
  "boundaries": [
    {
      "id": "sql-compilation",
      "profile": "Finite SQL, prepared parameters, literal Table mutations, offline state declarations and cursor assistance",
      "owners": [
        "packages/zig/transit-fuze/src/Sql*.zig",
        "packages/zig/transit-fuze/src/Prepared.zig",
        "packages/zig/transit-fuze/src/Declaration.zig"
      ],
      "exclude": [
        "packages/zig/transit-fuze/src/SqlCodes.zig",
        "packages/zig/transit-fuze/src/SqlDiagnostic.zig"
      ],
      "registry": "packages/zig/transit-fuze/src/SqlCodes.zig",
      "projection": "packages/zig/transit-fuze/src/SqlDiagnostic.zig",
      "stage": "parse or bind, from the original compiler boundary",
      "outcome": "not_submitted",
      "durable_evidence": "No dispatch occurs during compilation; previously saved work remains separate.",
      "context": "Owned source location, name/scope, expected/supplied type or scalar, parameter sites, row/key, counts and schema commitments when supplied by the failing owner",
      "disclosure": "Bounded caller input and authorized schema context; no new stored-data lookup, credentials or telemetry payloads",
      "recovery": "Correct input, inspect the supported scope or recompile a changed source; never resume/cancel a fresh command for a compile failure",
      "propagation": "Allocation, imported I/O and unexpected inferred failures bypass SQL classification and retain the actual caller attempt/outcome boundary.",
      "tests": [
        {
          "source": "packages/zig/transit-fuze/src/SqlDiagnostic.zig",
          "name": "SQL code registry is unique and every entry projects a valid bounded value"
        },
        {
          "source": "packages/zig/transit-query/src/ApiDiagnostic.zig",
          "name": "caller diagnostics distinguish local rejection, unknown send and failed status inspection"
        }
      ],
      "exceptions": [
        {
          "source": "packages/zig/transit-fuze/src/Sql.zig",
          "cause": "IncompleteSql",
          "disposition": "control_flow",
          "reason": "Only the synthetic cursor token with an active assistance sink produces this sentinel; hint collection consumes it without executing SQL.",
          "tests": [
            {
              "source": "packages/zig/transit-query/src/Assistance.zig",
              "name": "independent cursor fixtures preserve grammar, scope, type and range boundaries"
            }
          ]
        },
        {
          "source": "packages/zig/transit-fuze/src/SqlInput.zig",
          "cause": "InvalidSqlCursor",
          "disposition": "mapped_boundary",
          "reason": "Editor cursor failure is an observational input error, separate from a submitted SQL statement or result cursor.",
          "projection": "packages/zig/transit-query/src/ApiDiagnostic.zig",
          "code": "query.invalid_sql_cursor",
          "tests": [
            {
              "source": "packages/zig/transit-query/src/ApiDiagnostic.zig",
              "name": "editor and typed predicate failures keep their own meaning without overriding uncertain submission"
            },
            {
              "source": "packages/zig/transit-fuze/src/SqlInput.zig",
              "name": "cursor ranges replace whole tokens and reject split UTF-8 or protected lexical context"
            }
          ]
        }
      ],
