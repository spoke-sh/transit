      "registry": "packages/zig/transit-station-app/src/MigrationFailure.zig",
      "registry_kind": "named_class",
      "projection": "packages/zig/transit-station-app/src/MigrationFailure.zig",
      "profile": "Application data-owner migration ledger; application transforms own additional finite rejection classifications",
      "stage": "Input/control/admission/execute/cleanup as recorded by the original failed check",
      "outcome": "input_rejected, separate from plan progress and committed step receipts",
      "durable_evidence": "Original input commitment and original policy/plan/step/epoch witness in a companion record; owner rolls back before recording rejection",
      "context": "Original caller/plan/ordinal, expected/observed policies, epochs/contracts, commitments and progress when the rejecting check supplies them",
      "disclosure": "Current resource read authority; application values belong to the owning application and are not inferred by the ledger",
      "recovery": "Inspect exact plan and retained receipts; current denial and rejected inputs never imply plan cancellation or fresh retry permission",
      "propagation": "Native/storage/allocation, configuration and invalid transform output remain unresolved. Application transform failures require an application-owned finite classification; unknown errors must not become terminal rejection.",
