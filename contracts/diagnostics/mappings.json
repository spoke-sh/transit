    {
      "id": "sql-compilation",
      "profile": "Finite SQL, prepared parameters, literal Table mutations, offline state declarations and cursor assistance",
      "owners": [
        "packages/zig/transit-fuze/src/Sql*.zig",
        "packages/zig/transit-fuze/src/Prepared.zig",
        "packages/zig/transit-fuze/src/Declaration.zig"
