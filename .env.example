# Copy to .env and load through direnv (.envrc). Unset settings use the
# installation's saved values, or loopback defaults for a new installation.
# Apply changes with launchers::PROFILE::down followed by up; keep your data.

# Board's IPv4 listener and port (local defaults: 127.0.0.1:18102).
# TRANSIT_BOARD_HOST=127.0.0.1
# TRANSIT_BOARD_PORT=18102
# Exact browser origin; separate from a wildcard listener address.
# TRANSIT_BOARD_PUBLIC_ORIGIN=http://127.0.0.1:18102
# TRANSIT_BOARD_ALLOW_INSECURE_HTTP=false

# Example: access a trusted development machine over the LAN.
# Board has no viewer sign-in; HTTP carries inspection data without encryption.
# TRANSIT_BOARD_HOST=0.0.0.0
# TRANSIT_BOARD_PORT=18102
# TRANSIT_BOARD_PUBLIC_ORIGIN=http://devbox.local:18102
# TRANSIT_BOARD_ALLOW_INSECURE_HTTP=true

# Optional installation selection / initial internal port range.
# TRANSIT_LAUNCHER_NAME=default
# TRANSIT_LAUNCHER_BASE_PORT=18100

# Defaults to this checkout's .cache/reference/kubeconfig in Nix and direnv.
# Explicitly select another kubeconfig without changing ~/.kube/config.
# TRANSIT_KUBECONFIG=/absolute/path/to/kubeconfig

# Service diagnostics, applied and saved on launcher up. Local defaults to
# text; Compose defaults to JSON. Each service can override the global choice.
# TRANSIT_LOG_LEVEL=info
# TRANSIT_LOG_FORMAT=text
# TRANSIT_BOARD_LOG_LEVEL=debug
# TRANSIT_NODE_LOG_LEVEL=debug
# TRANSIT_MAINTENANCE_LOG_LEVEL=info
# TRANSIT_COUNTER_LOG_LEVEL=info
# TRANSIT_BOARD_LOG_FORMAT=json
