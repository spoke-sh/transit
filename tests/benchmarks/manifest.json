{
  "definition": "transit.declarative-benchmarks.v1",
  "features": {
    "schema": {
      "status": "blocked",
      "owner": "docs/reference/sql/create-table.md",
      "reason": "Full benchmark schemas, keys and constraints exceed the two-column published Table profile."
    },
    "transactions": {
      "status": "blocked",
      "owner": "docs/reference/sql.md",
      "reason": "No declarative multi-statement transaction session; separate resources have no implicit atomic commit."
    },
    "relational": {
      "status": "blocked",
      "owner": "docs/reference/queries.md",
      "reason": "No joins, grouping, sorting or general subqueries; each finite plan reads one source."
    },
    "expressions": {
      "status": "blocked",
      "owner": "docs/reference/sql/expressions.md",
      "reason": "No decimal/date arithmetic, general expressions or compound predicates."
    },
    "bulk": {
      "status": "blocked",
      "owner": "docs/reference/sql.md",
      "reason": "No declarative COPY or query-driven INSERT/DELETE; literal inserts have at most three rows."
    },
    "suite_driver": {
      "status": "not_implemented",
      "owner": "tests/benchmarks/README.md",
      "reason": "Standard generators, scales, mixes, concurrency, timing rules and complete workload oracles are not implemented."
    }
  },
  "suites": [
    {
      "id": "TPC-C",
      "specification": "5.11.0",
      "url": "https://www.tpc.org/TPC_Documents_Current_Versions/pdf/tpc-c_v5.11.0.pdf",
