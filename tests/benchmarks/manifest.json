  "probes": [
    {
      "id": "join",
      "kind": "select",
      "sql": "SELECT stock.id FROM stock JOIN trade ON stock.id = trade.id",
      "expected_error": "UnsupportedConstruct"
    },
    {
      "id": "group",
      "kind": "select",
      "sql": "SELECT quantity, COUNT(*) FROM stock GROUP BY quantity",
      "expected_error": "InvalidSqlSyntax"
    },
    {
      "id": "order",
      "kind": "select",
      "sql": "SELECT id FROM stock ORDER BY id",
      "expected_error": "UnsupportedConstruct"
    },
    {
      "id": "arithmetic",
      "kind": "select",
      "sql": "SELECT SUM(quantity * 2) FROM stock",
      "expected_error": "InvalidSqlSyntax"
    },
    {
      "id": "compound",
      "kind": "select",
      "sql": "SELECT id FROM stock WHERE id > 0 AND quantity < 20",
      "expected_error": "UnsupportedConstruct"
    },
    {
      "id": "transaction",
      "kind": "select",
      "sql": "BEGIN",
      "expected_error": "UnsupportedStatement"
    },
    {
      "id": "decimal",
      "kind": "declaration",
      "sql": "CREATE TABLE stock (id INT64 NOT NULL, quantity DECIMAL(12,2) NULL)",
      "expected_error": "UnsupportedDeclarationType"
    },
    {
      "id": "wide_publication",
      "kind": "table_schema",
      "sql": "CREATE TABLE stock (id INT64 NOT NULL, quantity INT64 NULL, extra INT64 NULL)",
      "expected_error": "UnsupportedTableColumnCount"
    },
    {
      "id": "bulk_insert",
      "kind": "mutation",
      "sql": "INSERT INTO stock SELECT id, quantity FROM trade",
      "expected_error": "InvalidSqlSyntax"
    }
  ]
}
