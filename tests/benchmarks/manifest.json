  "components": [
    {
      "id": "tpc-c.lookup",
      "suite": "TPC-C",
      "kind": "select",
      "source": "stock",
      "sql": "SELECT quantity FROM stock WHERE id = 7"
    },
    {
      "id": "tpc-c.low_stock",
      "suite": "TPC-C",
      "kind": "select",
      "source": "stock",
      "sql": "SELECT COUNT(*) FROM stock WHERE quantity < 20"
    },
    {
      "id": "tpc-c.quantity_sum",
      "suite": "TPC-C",
      "kind": "select",
      "source": "stock",
      "sql": "SELECT SUM(quantity) FROM stock"
    },
    {
      "id": "tpc-c.declaration",
      "suite": "TPC-C",
      "kind": "declaration",
      "source": "stock",
      "sql": "CREATE TABLE stock (id INT64 NOT NULL, quantity INT64 NULL)"
    },
    {
      "id": "tpc-c.insert",
      "suite": "TPC-C",
      "kind": "mutation",
      "source": "stock",
      "sql": "INSERT INTO stock (id, quantity) VALUES (3, 12), (4, NULL), (5, 31)"
    },
    {
      "id": "tpc-c.update",
      "suite": "TPC-C",
      "kind": "mutation",
      "source": "stock",
      "sql": "UPDATE stock SET quantity = 42 WHERE id = 1"
    },
    {
      "id": "tpc-c.delete",
      "suite": "TPC-C",
      "kind": "mutation",
      "source": "stock",
      "sql": "DELETE FROM stock WHERE id = 2"
    },
    {
      "id": "tpc-e.lookup",
      "suite": "TPC-E",
