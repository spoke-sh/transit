      "sql": "SELECT SUM(quantity) FROM trade WHERE quantity > 50"
    },
    {
      "id": "tpc-e.recent",
      "suite": "TPC-E",
      "kind": "select",
      "source": "trade",
      "sql": "SELECT id, quantity FROM trade WHERE id >= 11 LIMIT 8"
    },
    {
      "id": "tpc-e.declaration",
      "suite": "TPC-E",
