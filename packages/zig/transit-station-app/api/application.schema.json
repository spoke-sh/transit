{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:transit:application:v1",
  "$ref": "#/$defs/Definition",
  "$defs": {
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "x-transit-field-order": [
        "version",
        "name",
        "realm",
        "revision",
        "components",
        "entry",
        "theme",
        "themes",
        "screens",
        "bindings",
        "actions"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        },
        "realm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-transit-bits": 64,
          "x-transit-signed": false
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-transit-encoding": "unsigned-decimal-u64"
        },
        "components": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-transit-bits": 16,
          "x-transit-signed": false
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        },
        "themes": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/Theme"
          }
        },
        "screens": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/Screen"
          }
        },
        "bindings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/Binding"
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/Action"
          }
        }
      },
      "required": [
        "name",
        "realm",
        "revision",
        "entry",
        "theme",
        "themes",
        "screens",
        "bindings",
        "actions"
      ],
      "x-transit-defaults": {
        "version": 1,
        "components": 1
      }
    },
    "Theme": {
      "type": "object",
      "additionalProperties": false,
      "x-transit-field-order": [
        "name",
        "density"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        },
        "density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ]
        }
      },
      "required": [
        "name",
        "density"
      ],
      "x-transit-defaults": {}
    },
    "Screen": {
      "type": "object",
      "additionalProperties": false,
      "x-transit-field-order": [
        "name",
        "path",
        "label",
        "area",
        "renderer",
        "binding"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^/[A-Za-z_0-9/-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "area": {
          "type": "string",
          "enum": [
            "workspace",
            "operations"
          ]
        },
        "renderer": {
          "type": "string",
          "enum": [
            "atlas",
            "worksheet",
            "records",
            "activity",
            "definition",
            "operations",
            "work_items"
          ]
        },
        "binding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        }
      },
      "required": [
        "name",
        "path",
        "label",
        "area",
        "renderer",
        "binding"
      ],
      "x-transit-defaults": {}
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "x-transit-field-order": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "inspection"
              ],
              "properties": {
                "inspection": {
                  "type": "object",
                  "additionalProperties": false,
                  "x-transit-field-order": [
                    "projection",
                    "page_budget"
                  ],
                  "properties": {
                    "projection": {
                      "type": "string",
                      "enum": [
                        "atlas",
                        "resources",
                        "processes",
                        "records",
                        "capabilities",
                        "activity"
                      ]
                    },
                    "page_budget": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255,
                      "x-transit-bits": 8,
                      "x-transit-signed": false
                    }
                  },
                  "required": [
                    "projection"
                  ],
                  "x-transit-defaults": {
                    "page_budget": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query"
              ],
              "properties": {
                "query": {
                  "type": "object",
                  "additionalProperties": false,
                  "x-transit-field-order": [
                    "resource",
                    "name",
                    "source_kind",
                    "schema",
                    "profile",
                    "sql",
                    "refresh",
                    "starts"
                  ],
                  "properties": {
                    "resource": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "x-transit-bits": 64,
                      "x-transit-signed": false
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
                    },
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "table",
                        "kv",
                        "document"
                      ]
                    },
                    "schema": {
                      "type": "array",
                      "minItems": 32,
                      "maxItems": 32,
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255,
                        "x-transit-bits": 8,
                        "x-transit-signed": false
                      }
                    },
                    "profile": {
                      "type": "string",
                      "enum": [
                        "table_v1",
                        "unified_v2"
                      ]
                    },
                    "sql": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "refresh": {
                      "type": "string",
                      "enum": [
                        "snapshot",
                        "follow"
                      ]
                    },
                    "starts": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255,
                      "x-transit-bits": 8,
                      "x-transit-signed": false
                    }
                  },
                  "required": [
                    "resource",
                    "name",
                    "source_kind",
                    "schema",
                    "profile",
                    "sql"
                  ],
                  "x-transit-defaults": {
                    "refresh": "snapshot",
                    "starts": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "object",
                  "additionalProperties": false,
                  "x-transit-field-order": [
                    "service",
                    "target",
                    "revision",
                    "codec"
                  ],
                  "properties": {
                    "service": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "x-transit-bits": 64,
                      "x-transit-signed": false
                    },
                    "target": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "x-transit-bits": 64,
                      "x-transit-signed": false
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "x-transit-bits": 64,
                      "x-transit-signed": false
                    },
                    "codec": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535,
                      "x-transit-bits": 16,
                      "x-transit-signed": false
                    }
                  },
                  "required": [
                    "service",
                    "target",
                    "revision",
                    "codec"
                  ],
                  "x-transit-defaults": {}
                }
              }
            }
          ]
        }
      },
      "required": [
        "name",
        "source"
      ],
      "x-transit-defaults": {}
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "x-transit-field-order": [
        "name",
        "label",
        "target"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "navigate"
              ],
              "properties": {
                "navigate": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "follow"
              ],
              "properties": {
                "follow": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            }
          ]
        }
      },
      "required": [
        "name",
        "label",
        "target"
      ],
      "x-transit-defaults": {}
    },
    "Configuration": {
      "type": "object",
      "additionalProperties": false,
      "x-transit-field-order": [
        "application",
        "namespace",
        "realm",
        "administrator",
        "name_digest"
      ],
      "properties": {
        "application": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-transit-bits": 64,
          "x-transit-signed": false
        },
        "namespace": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-transit-encoding": "unsigned-decimal-u64"
        },
        "realm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-transit-bits": 64,
          "x-transit-signed": false
        },
        "administrator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-transit-bits": 64,
          "x-transit-signed": false
        },
        "name_digest": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "x-transit-bits": 8,
            "x-transit-signed": false
          }
        }
      },
      "required": [
        "application",
        "namespace",
        "realm",
        "administrator",
        "name_digest"
      ],
      "x-transit-defaults": {}
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "x-transit-field-order": [
        "revision",
        "publish"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-transit-encoding": "unsigned-decimal-u64"
        },
        "publish": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "publish"
      ],
      "x-transit-defaults": {}
    },
    "Proposal": {
      "type": "object",
      "additionalProperties": false,
      "x-transit-field-order": [
        "operation",
        "record",
        "expected",
        "expected_digest",
        "revision",
        "spec"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-transit-encoding": "unsigned-decimal-u64"
        },
        "record": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-transit-encoding": "unsigned-decimal-u64"
        },
        "expected": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-transit-encoding": "unsigned-decimal-u64"
        },
        "expected_digest": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "x-transit-bits": 8,
            "x-transit-signed": false
          }
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-transit-encoding": "unsigned-decimal-u64"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "x-transit-field-order": [
            "format",
            "length",
            "digest"
          ],
          "properties": {
            "format": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "x-transit-bits": 32,
              "x-transit-signed": false
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "x-transit-bits": 32,
              "x-transit-signed": false
            },
            "digest": {
              "type": "array",
              "minItems": 32,
              "maxItems": 32,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255,
                "x-transit-bits": 8,
                "x-transit-signed": false
              }
            }
          },
          "required": [
            "format",
            "length",
            "digest"
          ],
          "x-transit-defaults": {}
        }
      },
      "required": [
        "operation",
        "record",
        "expected",
        "expected_digest",
        "revision",
        "spec"
      ],
      "x-transit-defaults": {}
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "x-transit-field-order": [
        "proposal",
        "phase",
        "input",
        "owns_record"
      ],
      "properties": {
        "proposal": {
          "type": "object",
          "additionalProperties": false,
          "x-transit-field-order": [
            "operation",
            "record",
            "expected",
            "expected_digest",
            "revision",
            "spec"
          ],
          "properties": {
            "operation": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20,
              "x-transit-encoding": "unsigned-decimal-u64"
            },
            "record": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20,
              "x-transit-encoding": "unsigned-decimal-u64"
            },
            "expected": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20,
              "x-transit-encoding": "unsigned-decimal-u64"
            },
            "expected_digest": {
              "type": "array",
              "minItems": 32,
              "maxItems": 32,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255,
                "x-transit-bits": 8,
                "x-transit-signed": false
              }
            },
            "revision": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20,
              "x-transit-encoding": "unsigned-decimal-u64"
            },
            "spec": {
              "type": "object",
              "additionalProperties": false,
              "x-transit-field-order": [
                "format",
                "length",
                "digest"
              ],
              "properties": {
                "format": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295,
                  "x-transit-bits": 32,
                  "x-transit-signed": false
                },
                "length": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295,
                  "x-transit-bits": 32,
                  "x-transit-signed": false
                },
                "digest": {
                  "type": "array",
                  "minItems": 32,
                  "maxItems": 32,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255,
                    "x-transit-bits": 8,
                    "x-transit-signed": false
                  }
                }
              },
              "required": [
                "format",
                "length",
                "digest"
              ],
              "x-transit-defaults": {}
            }
          },
          "required": [
            "operation",
            "record",
            "expected",
            "expected_digest",
            "revision",
            "spec"
          ],
          "x-transit-defaults": {}
        },
        "phase": {
          "type": "string",
          "enum": [
            "staging",
            "applied",
            "conflict",
            "abandoned"
          ]
        },
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-transit-bits": 64,
          "x-transit-signed": false
        },
        "owns_record": {
          "type": "boolean"
        }
      },
      "required": [
        "proposal",
        "phase",
        "input",
        "owns_record"
      ],
      "x-transit-defaults": {}
    },
    "Head": {
      "type": "object",
      "additionalProperties": false,
      "x-transit-field-order": [
        "revision",
        "record",
        "spec",
        "principal",
        "operation",
        "input"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-transit-encoding": "unsigned-decimal-u64"
        },
        "record": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-transit-encoding": "unsigned-decimal-u64"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "x-transit-field-order": [
            "format",
            "length",
            "digest"
          ],
          "properties": {
            "format": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "x-transit-bits": 32,
              "x-transit-signed": false
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "x-transit-bits": 32,
              "x-transit-signed": false
            },
            "digest": {
              "type": "array",
              "minItems": 32,
              "maxItems": 32,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255,
                "x-transit-bits": 8,
                "x-transit-signed": false
              }
            }
          },
          "required": [
            "format",
            "length",
            "digest"
          ],
          "x-transit-defaults": {}
        },
        "principal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-transit-bits": 64,
          "x-transit-signed": false
        },
        "operation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-transit-encoding": "unsigned-decimal-u64"
        },
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-transit-bits": 64,
          "x-transit-signed": false
        }
      },
      "required": [
        "revision",
        "record",
        "spec",
        "principal",
        "operation",
        "input"
      ],
      "x-transit-defaults": {}
    }
  }
}
