-ifndef(TRANSIT_STATION_SDK_HRL).
-define(TRANSIT_STATION_SDK_HRL, true).
-include_lib("transit_client/include/transit_client.hrl").
-record(transit_activation, {process :: #transit_process{}, generation :: transit_counter(), credential :: #transit_credential{}}).
-record(transit_service, {client :: #transit_config{}, activation :: #transit_activation{}, association = <<"data">> :: binary(), query_results = false :: boolean()}).
-record(transit_key, {name :: binary(), codec :: module()}).
-record(transit_incoming, {kind :: cast | call | reply, value :: term(), position :: transit_counter(), origin :: term(), correlation = undefined :: undefined | pos_integer()}).
-record(transit_control, {kind :: cancel | timeout, position :: transit_counter(), origin :: term(), correlation :: pos_integer()}).
-record(transit_query_failure, {position :: transit_counter(), origin :: term(), correlation :: pos_integer(), result :: transit_counter(),
    reason :: result_too_large | workspace_exceeded | overflow | cancelled | denied}).
-record(transit_result_complete, {position :: transit_counter(), origin :: term(), correlation :: pos_integer()}).
-record(transit_read_version, {pid :: transit_counter(), input :: transit_counter(), index :: 0..255}).
-record(transit_basis, {resource :: #transit_resource{}, revision :: non_neg_integer(), schema :: binary()}).
-record(transit_page, {entries = [] :: list(), cursor = undefined :: undefined | binary(), basis = undefined :: undefined | #transit_basis{}}).
-record(transit_kv_entry, {key :: binary(), value :: binary(), revision :: non_neg_integer()}).
-record(transit_table_basis, {resource :: #transit_resource{}, revision :: transit_counter(), object :: pos_integer(), head :: binary()}).
-record(transit_row, {identity :: binary(), cells :: list()}).
-record(transit_table_page, {rows = [] :: list(), next = undefined :: undefined | binary()}).
-record(transit_table_creation, {state :: building | applied, admitted_input :: transit_counter(), completed_input = undefined :: undefined | transit_counter()}).
-record(transit_table_witness, {source, row = undefined, column, text, truncated}).
-record(transit_table_status, {reference, state, route, admitted_input, completed_input = undefined, counts = undefined, rejection, witness = undefined}).
-record(transit_query_job, {result :: transit_counter(), correlation :: pos_integer(), source :: #transit_read_version{}}).
-record(transit_manifest, {result, source, destination, correlation, table, policy_revision, basis, plan, segments, byte_count, rows, chain, schema}).
-record(transit_ipc_segment, {manifest :: #transit_manifest{}, ordinal :: non_neg_integer(), rows :: non_neg_integer(), digest :: binary(), ipc :: binary()}).
-record(transit_frozen, {identity :: #transit_identity{}, purpose :: permit | open | commit, input :: transit_counter(), bytes :: binary()}).
-record(transit_committed, {input :: transit_counter(), receipt :: #transit_receipt{}}).
-record(transit_blocked, {input = undefined :: undefined | transit_counter(), receipt = undefined :: undefined | #transit_receipt{}}).
-record(transit_needs_recovery, {mutation :: #transit_frozen{}, phase :: atom(), error :: #transit_error{}, receipt = undefined :: undefined | #transit_receipt{}}).
-record(transit_runner_shutdown, {pending = undefined :: undefined | #transit_frozen{}, last_event = undefined :: term()}).
-record(transit_http_request, {method, target = [], headers = []}).
-record(transit_http_prepared, {resource, namespace, reference, metadata, body}).
-record(transit_http_outcome, {phase, resource, exchange, effect, attempt, status = undefined, reference = undefined, diagnostic}).
-record(transit_http_rejected, {reason, diagnostic}).
-record(transit_http_released, {resource, exchange}).
-record(transit_http_part, {kind, bytes, complete = false}).
-record(transit_grpc_method, {path, shape, descriptor_digest}).
-record(transit_grpc_request, {method, metadata = []}).
-record(transit_grpc_prepared, {resource, namespace, reference, metadata, batch}).
-record(transit_grpc_outcome, {phase, resource, exchange, effect, attempt, status = undefined, reference = undefined, diagnostic}).
-record(transit_grpc_rejected, {reason, diagnostic}).
-record(transit_grpc_released, {resource, exchange}).
-record(transit_grpc_part, {kind, bytes, complete = false}).
-record(transit_document_dot, {counter = 0 :: non_neg_integer(), replica = 0 :: non_neg_integer()}).
-record(transit_document_change, {document, epoch = 1, type_revision = 1, replica, previous = 0, first, operations = []}).
-record(transit_document_prepared, {document, bytes :: binary()}).
-record(transit_document_reference, {resource :: #transit_resource{}, document, epoch, type_revision, revision}).
-record(transit_document_assignment, {id :: #transit_document_dot{}, value}).
-record(transit_document_field, {status, assignments = []}).
-record(transit_document_description, {reference, source_revision, floor, merge_window, active_job, retired, change_format}).
-record(transit_document_path, {reference, source_revision, field}).
-record(transit_document_item, {id, field}).
-record(transit_document_page, {reference, source_revision, items = [], next = undefined}).
-record(transit_document_resynchronization, {reference, floor, replica, previous_counter, clock}).
-record(transit_document_progress, {phase, revision = undefined}).
-endif.
