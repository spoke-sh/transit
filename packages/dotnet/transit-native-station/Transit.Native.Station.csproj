<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version><PackageId>Transit.Native.Station</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Linux x86_64 shared Zig Station library for the Transit .NET SDK.</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="native/libtransit_station.so" LogicalName="transit.station.native" />
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
