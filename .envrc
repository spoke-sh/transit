# Use /var/tmp for sccache temp files (avoids tmpfs space issues and
# stale nix-shell temp dirs when sccache server outlives the shell)
export TMPDIR=/var/tmp
# Register the packaged plugin's inputs before nix-direnv checks its cache.
watch_file apps/kubectl-transit/main.zig nix/kubectl-transit.nix
use flake

# Per-checkout development settings; .env is intentionally ignored by Git.
dotenv_if_exists .env
source_env nix/dev-environment.sh
