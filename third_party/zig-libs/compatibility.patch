-    /// Write the wire form of the authority for a Host header:
-    /// `host` / `[v6]` plus `:port` when non-default.
-    pub fn writeHostHeaderValue(u: Url, w: *std.Io.Writer) std.Io.Writer.Error!void {
-        if (u.hostIsV6()) {
-            try w.print("[{s}]", .{u.host});
-        } else {
