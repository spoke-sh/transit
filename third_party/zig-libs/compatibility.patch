-        }
-        try without.messages(gpa, &msgs2);
-        var d2 = try pb.decode(EchoReply, gpa, msgs2.items[0], .{});
-        defer d2.deinit();
-        try rv.expectReportedInt("deadline.none", d2.value.index);
-    }
-
-    // ── a reply spanning many DATA frames ──
