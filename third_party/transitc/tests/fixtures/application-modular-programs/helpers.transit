IMPORT ids FROM 'types.transit';

CREATE FUNCTION clean_note(note TEXT) RETURNS TEXT AS BEGIN
  RETURN CASE WHEN note = '' THEN 'empty' ELSE CASE WHEN note = 'priority' THEN 'priority-note' ELSE note END END;
END;

CREATE FUNCTION tier_window(amount BIGINT) RETURNS TEXT AS BEGIN
  RETURN CASE
    WHEN amount >= 1000 THEN 'window=institutional-clearance-corridor-v1/band=large/ledger-policy=primary-verified-settlement-lane-alpha-01'
    ELSE CASE
      WHEN amount >= 100 THEN 'window=commercial-clearance-corridor-v1/band=medium/ledger-policy=standard-verified-settlement-lane-beta-02'
      ELSE 'window=retail-micro-clearance-corridor-v1/band=small/ledger-policy=automated-verified-settlement-lane-gamma-03'
    END
  END;
END;

CREATE FUNCTION fee_schedule(amount BIGINT) RETURNS TEXT AS BEGIN
  RETURN CASE
    WHEN amount >= 1000 THEN 'schedule=tier-alpha/corridor=priority-wire-settlement-profile-v1/settlement-class=institutional-high-value-order'
    ELSE CASE
      WHEN amount >= 250 THEN 'schedule=tier-beta/corridor=standard-commercial-settlement-profile-v1/settlement-class=commercial-mid-value-order'
      ELSE 'schedule=tier-gamma/corridor=economy-batch-settlement-profile-v1/settlement-class=automated-low-value-order-lane'
    END
  END;
END;

CREATE FUNCTION compliance_profile(amount BIGINT) RETURNS TEXT AS BEGIN
  RETURN CASE
    WHEN amount >= 1000 THEN 'compliance=dual-control-ledger-stream-followup-atomic-v1/hygiene=lexical-frame-isolated/audit-band=institutional'
    ELSE CASE
      WHEN amount >= 100 THEN 'compliance=verified-account-tier-credit-guard-atomic-v1/hygiene=lexical-frame-isolated/audit-band=commercial-std'
      ELSE 'compliance=automated-account-guard-atomic-settlement-v1/hygiene=lexical-frame-isolated/audit-band=retail-standard'
    END
  END;
END;

CREATE PUBLIC FUNCTION valid_amount(amount BIGINT, ignored ids.OrderId) RETURNS BOOLEAN AS BEGIN
  RETURN amount > 0 AND amount <= 1000000;
END;

CREATE PUBLIC FUNCTION preserve_order(order_id ids.OrderId) RETURNS ids.OrderId AS BEGIN
  RETURN order_id;
END;

CREATE PUBLIC FUNCTION preserve_account(account_id ids.AccountId) RETURNS ids.AccountId AS BEGIN
  RETURN account_id;
END;

CREATE PUBLIC FUNCTION same_token(token TEXT) RETURNS BOOLEAN AS BEGIN
  RETURN token = token;
END;

CREATE PUBLIC FUNCTION amount_band(amount BIGINT) RETURNS TEXT AS BEGIN
  RETURN CASE WHEN amount >= 1000 THEN 'large' ELSE CASE WHEN amount >= 100 THEN 'medium' ELSE 'small' END END;
END;

CREATE PUBLIC FUNCTION risk_label(amount BIGINT, note TEXT) RETURNS TEXT AS BEGIN
  RETURN CASE
    WHEN amount >= 1000 AND clean_note(note) = 'empty' THEN 'review'
    ELSE CASE
      WHEN amount >= 1000 THEN 'elevated'
      ELSE CASE
        WHEN clean_note(note) = 'priority-note' THEN 'expedited'
        ELSE 'routine'
      END
    END
  END;
END;

CREATE PUBLIC FUNCTION settlement_profile(amount BIGINT) RETURNS TEXT AS BEGIN
  RETURN tier_window(amount) || '|' || fee_schedule(amount) || '|' || compliance_profile(amount);
END;

CREATE PUBLIC FUNCTION format_summary(amount BIGINT, note TEXT) RETURNS TEXT AS BEGIN
  RETURN amount_band(amount) || ':' || risk_label(amount, note) || ':' || clean_note(note) || ':' || settlement_profile(amount);
END;

CREATE GUARD require_supported_tier(tier TEXT) AS BEGIN
  REQUIRE tier = 'gold' OR tier = 'standard' ELSE 'UnsupportedTier';
END;

CREATE PUBLIC GUARD verify_account(
  accounts TABLE(id ids.AccountId PRIMARY KEY, active BOOLEAN NOT NULL, tier TEXT NOT NULL, credit_limit BIGINT NOT NULL),
  target ids.AccountId,
  amount BIGINT
) AS BEGIN
  LET account = SELECT id, active, tier, credit_limit FROM accounts WHERE id = target;
  REQUIRE account IS NOT NULL AND account.id = preserve_account(target) ELSE 'MissingAccount';
  REQUIRE account.active ELSE 'InactiveAccount';
  CHECK GUARD require_supported_tier(account.tier);
  REQUIRE amount <= account.credit_limit ELSE 'CreditLimitExceeded';
END;

CREATE PROCEDURE publish_outputs(
  events STREAM(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, summary TEXT NOT NULL),
  followup QUEUE(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, summary TEXT NOT NULL),
  order_id ids.OrderId,
  account_id ids.AccountId,
  summary TEXT
) AS BEGIN ATOMIC
  PRODUCE INTO events VALUES (preserve_order(order_id), preserve_account(account_id), summary);
  ENQUEUE INTO followup VALUES (preserve_order(order_id), preserve_account(account_id), summary);
END;

CREATE PUBLIC PROCEDURE settle_order(
  ledger TABLE(id ids.OrderId PRIMARY KEY, account_id ids.AccountId NOT NULL, amount BIGINT NOT NULL, summary TEXT NOT NULL),
  events STREAM(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, summary TEXT NOT NULL),
  followup QUEUE(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, summary TEXT NOT NULL),
  order_id ids.OrderId,
  account_id ids.AccountId,
  amount BIGINT,
  note TEXT
) RETURNS ids.OrderId AS BEGIN ATOMIC
  LET summary = format_summary(amount, note);
  INSERT INTO ledger VALUES (preserve_order(order_id), preserve_account(account_id), amount, summary) ON CONFLICT (id) DO ASSERT SAME ROW;
  CALL publish_outputs(events, followup, preserve_order(order_id), preserve_account(account_id), summary);
  RETURN preserve_order(order_id);
END;
