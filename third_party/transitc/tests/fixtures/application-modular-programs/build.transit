IMPORT ids FROM 'types.transit';
IMPORT resources FROM 'resources.transit';
IMPORT workflow FROM 'workflow.transit';

CREATE MODULE SeedAccounts(
  accounts TABLE(id ids.AccountId PRIMARY KEY, active BOOLEAN NOT NULL, tier TEXT NOT NULL, credit_limit BIGINT NOT NULL),
  first ids.AccountId,
  second ids.AccountId,
  third ids.AccountId
) AS BEGIN
  INSERT INTO $accounts VALUES ($first, TRUE, 'gold', 5000), ($second, FALSE, 'standard', 1000), ($third, TRUE, 'standard', 500);
END;

CREATE MODULE SendOrder(
  input QUEUE(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, amount BIGINT NOT NULL, note TEXT NOT NULL),
  id ids.OrderId,
  account_id ids.AccountId,
  amount BIGINT,
  note TEXT
) AS BEGIN
  ENQUEUE INTO $input VALUES ($id, $account_id, $amount, $note);
END;

CREATE MODULE SendFollowup(
  followup QUEUE(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, summary TEXT NOT NULL),
  id ids.OrderId,
  account_id ids.AccountId,
  summary TEXT
) AS BEGIN
  ENQUEUE INTO $followup VALUES ($id, $account_id, $summary);
END;

CREATE MODULE Pipeline(
  input_name IDENTIFIER,
  accounts_name IDENTIFIER,
  ledger_name IDENTIFIER,
  events_name IDENTIFIER,
  followup_name IDENTIFIER,
  orders_name IDENTIFIER
) AS BEGIN
  USE resources.Resources(TYPE ids.OrderId, TYPE ids.AccountId, input_name, accounts_name, ledger_name, events_name, followup_name) AS data;
  USE SeedAccounts(data.accounts, ids.AccountId(7), ids.AccountId(8), ids.AccountId(9));
  USE workflow.Workflow(orders_name, data.input, data.accounts, data.ledger, data.events, data.followup);
  EXPORT QUEUE data.input AS input;
  EXPORT QUEUE data.followup AS followup;
END;

CREATE MODULE DispatchPipeline(
  dispatch_name IDENTIFIER,
  dispatched_name IDENTIFIER,
  followup QUEUE(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, summary TEXT NOT NULL)
) AS BEGIN
  USE resources.DispatchTable(TYPE ids.OrderId, TYPE ids.AccountId, dispatched_name) AS out;
  USE workflow.Dispatch(dispatch_name, followup, out.dispatched);
END;

CREATE PUBLIC MODULE Scenario() AS BEGIN
  USE Pipeline(NAME 'modular_requests_a', NAME 'modular_accounts_a', NAME 'modular_ledger_a', NAME 'modular_events_a', NAME 'modular_followup_a', NAME 'modular_orders_a') AS a;
  USE DispatchPipeline(NAME 'modular_dispatch_a', NAME 'modular_dispatched_a', a.followup);
  USE Pipeline(NAME 'modular_requests_b', NAME 'modular_accounts_b', NAME 'modular_ledger_b', NAME 'modular_events_b', NAME 'modular_followup_b', NAME 'modular_orders_b') AS b;
  USE DispatchPipeline(NAME 'modular_dispatch_b', NAME 'modular_dispatched_b', b.followup);
  USE SendOrder(a.input, ids.OrderId(101), ids.AccountId(7), 250, 'priority');
  USE SendOrder(a.input, ids.OrderId(102), ids.AccountId(99), 250, 'priority');
  USE SendOrder(a.input, ids.OrderId(103), ids.AccountId(8), 250, 'priority');
  USE SendOrder(a.input, ids.OrderId(104), ids.AccountId(9), 800, 'priority');
  USE SendOrder(a.input, ids.OrderId(105), ids.AccountId(7), 250, 'rollback_after_call');
  USE SendOrder(b.input, ids.OrderId(201), ids.AccountId(7), 1500, '');
END;

CREATE TARGET default AS BEGIN
  USE Scenario();
END;

CREATE TEST TARGET tests AS BEGIN
  TEST 'accepted modular order commits table stream and followup queue' USING MODULES () AS BEGIN
    USE Pipeline(NAME 'modular_requests_a', NAME 'modular_accounts_a', NAME 'modular_ledger_a', NAME 'modular_events_a', NAME 'modular_followup_a', NAME 'modular_orders_a') AS a;
    USE SendOrder(a.input, ids.OrderId(101), ids.AccountId(7), 250, 'priority');
    ASSERT WORKFLOW NAME 'modular_orders_a' COMPLETED 1 REFUSED 0 WITHIN 1000 OBSERVATIONS;
    ASSERT ROWS (SELECT id, account_id, amount, summary FROM modular_ledger_a) EQUAL ((101, 7, 250, 'medium:expedited:priority-note:window=commercial-clearance-corridor-v1/band=medium/ledger-policy=standard-verified-settlement-lane-beta-02|schedule=tier-beta/corridor=standard-commercial-settlement-profile-v1/settlement-class=commercial-mid-value-order|compliance=verified-account-tier-credit-guard-atomic-v1/hygiene=lexical-frame-isolated/audit-band=commercial-std'));
    ASSERT ROWS (CONSUME id, account_id, summary FROM modular_events_a) EQUAL ((101, 7, 'medium:expedited:priority-note:window=commercial-clearance-corridor-v1/band=medium/ledger-policy=standard-verified-settlement-lane-beta-02|schedule=tier-beta/corridor=standard-commercial-settlement-profile-v1/settlement-class=commercial-mid-value-order|compliance=verified-account-tier-credit-guard-atomic-v1/hygiene=lexical-frame-isolated/audit-band=commercial-std'));
  END;
  TEST 'missing account guard refuses before procedure' USING MODULES () AS BEGIN
    USE Pipeline(NAME 'modular_requests_a', NAME 'modular_accounts_a', NAME 'modular_ledger_a', NAME 'modular_events_a', NAME 'modular_followup_a', NAME 'modular_orders_a') AS a;
    USE SendOrder(a.input, ids.OrderId(102), ids.AccountId(99), 250, 'priority');
    ASSERT WORKFLOW NAME 'modular_orders_a' COMPLETED 0 REFUSED 1 WITHIN 1000 OBSERVATIONS;
    ASSERT ROWS (SELECT id, account_id, amount, summary FROM modular_ledger_a) EQUAL ();
    ASSERT ROWS (CONSUME id, account_id, summary FROM modular_events_a) EQUAL ();
  END;
  TEST 'inactive account guard refuses before procedure' USING MODULES () AS BEGIN
    USE Pipeline(NAME 'modular_requests_a', NAME 'modular_accounts_a', NAME 'modular_ledger_a', NAME 'modular_events_a', NAME 'modular_followup_a', NAME 'modular_orders_a') AS a;
    USE SendOrder(a.input, ids.OrderId(103), ids.AccountId(8), 250, 'priority');
    ASSERT WORKFLOW NAME 'modular_orders_a' COMPLETED 0 REFUSED 1 WITHIN 1000 OBSERVATIONS;
    ASSERT ROWS (SELECT id, account_id, amount, summary FROM modular_ledger_a) EQUAL ();
    ASSERT ROWS (CONSUME id, account_id, summary FROM modular_events_a) EQUAL ();
  END;
  TEST 'credit limit guard refuses after active and tier checks' USING MODULES () AS BEGIN
    USE Pipeline(NAME 'modular_requests_a', NAME 'modular_accounts_a', NAME 'modular_ledger_a', NAME 'modular_events_a', NAME 'modular_followup_a', NAME 'modular_orders_a') AS a;
    USE SendOrder(a.input, ids.OrderId(104), ids.AccountId(9), 800, 'priority');
    ASSERT WORKFLOW NAME 'modular_orders_a' COMPLETED 0 REFUSED 1 WITHIN 1000 OBSERVATIONS;
    ASSERT ROWS (SELECT id, account_id, amount, summary FROM modular_ledger_a) EQUAL ();
    ASSERT ROWS (CONSUME id, account_id, summary FROM modular_events_a) EQUAL ();
  END;
  TEST 'post-call guard rolls back inlined atomic procedure' USING MODULES () AS BEGIN
    USE Pipeline(NAME 'modular_requests_a', NAME 'modular_accounts_a', NAME 'modular_ledger_a', NAME 'modular_events_a', NAME 'modular_followup_a', NAME 'modular_orders_a') AS a;
    USE SendOrder(a.input, ids.OrderId(105), ids.AccountId(7), 250, 'rollback_after_call');
    ASSERT WORKFLOW NAME 'modular_orders_a' COMPLETED 0 REFUSED 1 WITHIN 1000 OBSERVATIONS;
    ASSERT ROWS (SELECT id, account_id, amount, summary FROM modular_ledger_a) EQUAL ();
    ASSERT ROWS (CONSUME id, account_id, summary FROM modular_events_a) EQUAL ();
  END;
  TEST 'independent named modular dispatch pipeline' USING MODULES () AS BEGIN
    USE resources.StandaloneFollowup(TYPE ids.OrderId, TYPE ids.AccountId, NAME 'modular_followup_b') AS q;
    USE DispatchPipeline(NAME 'modular_dispatch_b', NAME 'modular_dispatched_b', q.followup);
    USE SendFollowup(q.followup, ids.OrderId(201), ids.AccountId(7), 'large:review:empty:window=institutional-clearance-corridor-v1/band=large/ledger-policy=primary-verified-settlement-lane-alpha-01|schedule=tier-alpha/corridor=priority-wire-settlement-profile-v1/settlement-class=institutional-high-value-order|compliance=dual-control-ledger-stream-followup-atomic-v1/hygiene=lexical-frame-isolated/audit-band=institutional');
    ASSERT WORKFLOW NAME 'modular_dispatch_b' COMPLETED 1 REFUSED 0 WITHIN 1000 OBSERVATIONS;
    ASSERT ROWS (SELECT id, account_id, summary FROM modular_dispatched_b) EQUAL ((201, 7, 'large:review:empty:window=institutional-clearance-corridor-v1/band=large/ledger-policy=primary-verified-settlement-lane-alpha-01|schedule=tier-alpha/corridor=priority-wire-settlement-profile-v1/settlement-class=institutional-high-value-order|compliance=dual-control-ledger-stream-followup-atomic-v1/hygiene=lexical-frame-isolated/audit-band=institutional'));
  END;
END;
