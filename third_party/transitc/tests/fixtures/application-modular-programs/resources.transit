CREATE PUBLIC MODULE Resources(order_type TYPE, account_type TYPE,
  input_name IDENTIFIER, accounts_name IDENTIFIER, ledger_name IDENTIFIER,
  events_name IDENTIFIER, followup_name IDENTIFIER) AS BEGIN
  CREATE PUBLIC QUEUE $input_name (id $order_type NOT NULL, account_id $account_type NOT NULL, amount BIGINT NOT NULL, note TEXT NOT NULL);
  CREATE PUBLIC TABLE $accounts_name (id $account_type PRIMARY KEY, active BOOLEAN NOT NULL, tier TEXT NOT NULL, credit_limit BIGINT NOT NULL);
  CREATE PUBLIC TABLE $ledger_name (id $order_type PRIMARY KEY, account_id $account_type NOT NULL, amount BIGINT NOT NULL, summary TEXT NOT NULL);
  CREATE PUBLIC STREAM $events_name (id $order_type NOT NULL, account_id $account_type NOT NULL, summary TEXT NOT NULL);
  CREATE PUBLIC QUEUE $followup_name (id $order_type NOT NULL, account_id $account_type NOT NULL, summary TEXT NOT NULL);
  EXPORT QUEUE $input_name AS input;
  EXPORT TABLE $accounts_name AS accounts;
  EXPORT TABLE $ledger_name AS ledger;
  EXPORT STREAM $events_name AS events;
  EXPORT QUEUE $followup_name AS followup;
END;

CREATE PUBLIC MODULE DispatchTable(order_type TYPE, account_type TYPE, dispatched_name IDENTIFIER) AS BEGIN
  CREATE PUBLIC TABLE $dispatched_name (id $order_type PRIMARY KEY, account_id $account_type NOT NULL, summary TEXT NOT NULL);
  EXPORT TABLE $dispatched_name AS dispatched;
END;

CREATE PUBLIC MODULE StandaloneFollowup(order_type TYPE, account_type TYPE, followup_name IDENTIFIER) AS BEGIN
  CREATE PUBLIC QUEUE $followup_name (id $order_type NOT NULL, account_id $account_type NOT NULL, summary TEXT NOT NULL);
  EXPORT QUEUE $followup_name AS followup;
END;
