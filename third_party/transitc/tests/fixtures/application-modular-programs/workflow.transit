IMPORT ids FROM 'types.transit';
IMPORT helpers FROM 'helpers.transit';

CREATE PUBLIC MODULE Workflow(
  orders_name IDENTIFIER,
  input QUEUE(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, amount BIGINT NOT NULL, note TEXT NOT NULL),
  accounts TABLE(id ids.AccountId PRIMARY KEY, active BOOLEAN NOT NULL, tier TEXT NOT NULL, credit_limit BIGINT NOT NULL),
  ledger TABLE(id ids.OrderId PRIMARY KEY, account_id ids.AccountId NOT NULL, amount BIGINT NOT NULL, summary TEXT NOT NULL),
  events STREAM(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, summary TEXT NOT NULL),
  followup QUEUE(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, summary TEXT NOT NULL)
) AS BEGIN
  CREATE PUBLIC DATAFLOW $orders_name FROM QUEUE $input AS order_item
  WHERE helpers.valid_amount(order_item.amount, order_item.id)
  AS BEGIN
    BEGIN ATOMIC
      CHECK GUARD helpers.verify_account($accounts, order_item.account_id, order_item.amount);
      LET summary = 'caller-local-shadow-sentinel';
      REQUIRE helpers.same_token(RANDOM_TOKEN(16)) ELSE 'ImpureTokenMismatch';
      LET settled = CALL helpers.settle_order($ledger, $events, $followup, order_item.id, order_item.account_id, order_item.amount, order_item.note);
      REQUIRE settled = order_item.id ELSE 'WrongReturnedOrder';
      REQUIRE summary = 'caller-local-shadow-sentinel' AND order_item.note <> 'rollback_after_call' ELSE 'PostCallRejected';
    END;
  END;
  AUTHORIZE DATAFLOW $orders_name AS ROLE CURRENT_ROLE;
  ACTIVATE DATAFLOW $orders_name;
END;

CREATE PUBLIC MODULE Dispatch(
  dispatch_name IDENTIFIER,
  followup QUEUE(id ids.OrderId NOT NULL, account_id ids.AccountId NOT NULL, summary TEXT NOT NULL),
  dispatched TABLE(id ids.OrderId PRIMARY KEY, account_id ids.AccountId NOT NULL, summary TEXT NOT NULL)
) AS BEGIN
  CREATE PUBLIC DATAFLOW $dispatch_name FROM QUEUE $followup AS queued AS BEGIN
    BEGIN ATOMIC
      INSERT INTO $dispatched VALUES (helpers.preserve_order(queued.id), helpers.preserve_account(queued.account_id), queued.summary) ON CONFLICT (id) DO ASSERT SAME ROW;
    END;
  END;
  AUTHORIZE DATAFLOW $dispatch_name AS ROLE CURRENT_ROLE;
  ACTIVATE DATAFLOW $dispatch_name;
END;
