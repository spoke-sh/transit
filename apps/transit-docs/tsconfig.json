{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "types": ["node", "@docusaurus/module-type-aliases"],
    "paths": { "@site/*": ["./*"] }
  },
  "exclude": ["node_modules", "dist", ".docusaurus", ".generated"]
}
