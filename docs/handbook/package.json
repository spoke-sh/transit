    "mermaid": "11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.63.0",
    "@types/mdast": "4.0.4",
