        "nameOverride": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "image": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "config": {
          "type": "object"
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "format"
          ],
          "properties": {
            "level": {
              "enum": [
                "debug",
                "info",
                "warn",
                "error",
                "off"
              ]
            },
            "format": {
              "enum": [
                "text",
                "json"
              ]
            }
          }
        }
      }
    },
